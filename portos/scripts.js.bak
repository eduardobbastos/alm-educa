document.addEventListener('DOMContentLoaded', () => {
  const form = document.getElementById('leadForm');
  const whatsappInput = document.getElementById('whatsapp');

  if (whatsappInput) {
    whatsappInput.addEventListener('input', (e) => {
      let value = e.target.value.replace(/\D/g, '').slice(0, 11);
      if (value.length > 2) value = '(' + value.slice(0, 2) + ') ' + value.slice(2);
      if (value.length > 9) value = value.slice(0, 9) + '-' + value.slice(9, 13);
      e.target.value = value;
    });
  }

  if (form) {
    form.addEventListener('submit', (e) => {
      const nome = form.nome.value.trim();
      const email = form.email.value.trim();
      if (!nome || !email) {
        e.preventDefault();
        alert('Por favor, preencha nome e e-mail antes de continuar.');
        return;
      }

      const params = new URLSearchParams();
      params.set('nome', nome);
      params.set('email', email);
      if (form.whatsapp.value) params.set('whatsapp', form.whatsapp.value.replace(/\D/g, ''));
      if (form.empresa.value) params.set('empresa', form.empresa.value.trim());

      const url = new URL(form.action);
      url.search = '';
      for (const [k, v] of params) { url.searchParams.set(k, v); }
      form.action = url.toString();
    });
  }

  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        entry.target.classList.add('visible');
      }
    });
  }, { threshold: 0.12 });

  document.querySelectorAll('.module-card, .instructor-card, .guarantee').forEach((el) => {
    el.classList.add('reveal');
    observer.observe(el);
  });

  initPort3D();
});

/* ============================================================
   PORTO 3D — Three.js + GSAP ScrollTrigger
   ============================================================ */
function initPort3D() {
  const canvas = document.getElementById('portCanvas');
  const loader = document.getElementById('canvasLoader');
  if (!canvas) return;

  const isMobile = window.matchMedia('(pointer: coarse)').matches;

  // Three.js core
  const scene = new THREE.Scene();
  scene.background = null;
  scene.fog = new THREE.FogExp2(0x0f172a, 0.035);

  const camera = new THREE.PerspectiveCamera(50, 1, 0.1, 200);
  camera.position.set(8, 6, 12);
  camera.lookAt(0, 0, 0);

  const renderer = new THREE.WebGLRenderer({
    canvas,
    antialias: !isMobile,
    alpha: true,
    powerPreference: 'high-performance'
  });
  renderer.setPixelRatio(Math.min(window.devicePixelRatio, isMobile ? 1.5 : 2));
  renderer.shadowMap.enabled = true;
  renderer.shadowMap.type = THREE.PCFSoftShadowMap;
  renderer.toneMapping = THREE.ACESFilmicToneMapping;
  renderer.toneMappingExposure = 1.1;

  // Helpers
  const materials = {
    hull: new THREE.MeshStandardMaterial({ color: 0x334155, roughness: 0.45, metalness: 0.2 }),
    deck: new THREE.MeshStandardMaterial({ color: 0x475569, roughness: 0.55, metalness: 0.1 }),
    crane: new THREE.MeshStandardMaterial({ color: 0xf59e0b, roughness: 0.4, metalness: 0.25 }),
    craneDark: new THREE.MeshStandardMaterial({ color: 0xb45309, roughness: 0.5, metalness: 0.2 }),
    containerRed: new THREE.MeshStandardMaterial({ color: 0xef4444, roughness: 0.5, metalness: 0.1 }),
    containerGreen: new THREE.MeshStandardMaterial({ color: 0x22c55e, roughness: 0.5, metalness: 0.1 }),
    containerBlue: new THREE.MeshStandardMaterial({ color: 0x3b82f6, roughness: 0.5, metalness: 0.1 }),
    containerOrange: new THREE.MeshStandardMaterial({ color: 0xf97316, roughness: 0.5, metalness: 0.1 }),
    water: new THREE.MeshStandardMaterial({
      color: 0x0ea5e9,
      roughness: 0.05,
      metalness: 0.1,
      transparent: true,
      opacity: 0.82
    }),
    dock: new THREE.MeshStandardMaterial({ color: 0x64748b, roughness: 0.8 }),
    dockEdge: new THREE.MeshStandardMaterial({ color: 0x475569, roughness: 0.75 }),
    glass: new THREE.MeshStandardMaterial({ color: 0xbae6fd, roughness: 0.15, metalness: 0.7, transparent: true, opacity: 0.85 }),
    sun: new THREE.MeshBasicMaterial({ color: 0xfbbf24 })
  };

  // Water plane
  const waterGeometry = new THREE.PlaneGeometry(60, 40, 64, 64);
  const water = new THREE.Mesh(waterGeometry, materials.water);
  water.rotation.x = -Math.PI / 2;
  water.position.y = -0.65;
  water.receiveShadow = true;
  scene.add(water);

  // Ship group
  const ship = new THREE.Group();

  // Hull
  const hullGeo = new THREE.BoxGeometry(6, 1.3, 2.2);
  hullGeo.translate(0, 0.65, 0);
  const hull = new THREE.Mesh(hullGeo, materials.hull);
  hull.castShadow = true;
  hull.receiveShadow = true;
  ship.add(hull);

  // Deck
  const deckGeo = new THREE.BoxGeometry(5.4, 0.2, 2.05);
  deckGeo.translate(0, 1.35, 0);
  const deck = new THREE.Mesh(deckGeo, materials.deck);
  deck.castShadow = true;
  ship.add(deck);

  // Bow slope
  const bowGeo = new THREE.ConeGeometry(1.1, 1.8, 4);
  bowGeo.rotateY(Math.PI / 4);
  bowGeo.rotateZ(-Math.PI / 2);
  bowGeo.translate(3.3, 0.65, 0);
  const bow = new THREE.Mesh(bowGeo, materials.hull);
  bow.scale.set(1, 0.7, 1);
  bow.castShadow = true;
  ship.add(bow);

  // Bridge / superstructure
  const bridgeGeo = new THREE.BoxGeometry(1.2, 1.1, 1.3);
  bridgeGeo.translate(-1.6, 2.05, 0);
  const bridge = new THREE.Mesh(bridgeGeo, materials.deck);
  bridge.castShadow = true;
  ship.add(bridge);

  const bridgeTopGeo = new THREE.BoxGeometry(1, 0.5, 1.1);
  bridgeTopGeo.translate(-1.5, 2.85, 0);
  const bridgeTop = new THREE.Mesh(bridgeTopGeo, materials.glass);
  bridgeTop.castShadow = true;
  ship.add(bridgeTop);

  // Containers
  function addContainer(x, z, colorMat, rotationY = 0) {
    const w = 0.78 + Math.random() * 0.08;
    const h = 0.75 + Math.random() * 0.05;
    const d = 1.6 + Math.random() * 0.1;
    const geo = new THREE.BoxGeometry(w, h, d);
    const mesh = new THREE.Mesh(geo, colorMat);
    mesh.position.set(x, 1.75 + h / 2, z);
    mesh.rotation.y = rotationY;
    mesh.castShadow = true;
    mesh.receiveShadow = true;
    ship.add(mesh);
    return mesh;
  }

  const containerColors = [materials.containerRed, materials.containerGreen, materials.containerBlue, materials.containerOrange];
  for (let i = 0; i < 3; i++) {
    for (let j = 0; j < 2; j++) {
      addContainer(0.4 + i * 0.9, -0.55 + j * 0.9, containerColors[(i + j) % containerColors.length]);
    }
  }
  addContainer(-0.3, 0.35, materials.containerOrange, Math.PI / 2);

  ship.position.set(-1.2, -0.15, 0);
  ship.rotation.y = Math.PI * 0.04;
  scene.add(ship);

  // Dock
  const dock = new THREE.Group();
  const dockBaseGeo = new THREE.BoxGeometry(8, 1.2, 5);
  dockBaseGeo.translate(-5.5, 0, 2.5);
  const dockBase = new THREE.Mesh(dockBaseGeo, materials.dock);
  dockBase.receiveShadow = true;
  dockBase.castShadow = true;
  dock.add(dockBase);

  const dockEdgeGeo = new THREE.BoxGeometry(8, 0.25, 0.5);
  dockEdgeGeo.translate(-5.5, 0.72, 0.25);
  const dockEdge = new THREE.Mesh(dockEdgeGeo, materials.dockEdge);
  dockEdge.castShadow = true;
  dock.add(dockEdge);

  // Containers on the dock
  for (let i = 0; i < 4; i++) {
    const w = 0.78 + Math.random() * 0.08;
    const h = 0.75 + Math.random() * 0.05;
    const d = 1.6 + Math.random() * 0.1;
    const geo = new THREE.BoxGeometry(w, h, d);
    const mesh = new THREE.Mesh(geo, containerColors[i % containerColors.length]);
    mesh.position.set(-3.2 - i * 0.85, 0.65 + h / 2, 3.4);
    mesh.rotation.y = Math.PI / 2;
    mesh.castShadow = true;
    mesh.receiveShadow = true;
    dock.add(mesh);
  }
  scene.add(dock);

  // Crane
  const crane = new THREE.Group();
  const craneLegGeo = new THREE.BoxGeometry(0.4, 3.8, 0.4);
  craneLegGeo.translate(0, 1.9, 0);
  const craneLeg = new THREE.Mesh(craneLegGeo, materials.crane);
  craneLeg.castShadow = true;
  crane.add(craneLeg);

  const craneTopGeo = new THREE.BoxGeometry(0.7, 0.3, 0.7);
  craneTopGeo.translate(0, 3.95, 0);
  const craneTop = new THREE.Mesh(craneTopGeo, materials.craneDark);
  craneTop.castShadow = true;
  crane.add(craneTop);

  const craneArmGeo = new THREE.BoxGeometry(3.6, 0.22, 0.22);
  craneArmGeo.translate(1.8, 3.85, 0);
  const craneArm = new THREE.Mesh(craneArmGeo, materials.crane);
  craneArm.castShadow = true;
  crane.add(craneArm);

  const cableGeo = new THREE.CylinderGeometry(0.03, 0.03, 1.4, 8);
  cableGeo.translate(3.4, 3.15, 0);
  const cable = new THREE.Mesh(cableGeo, new THREE.MeshStandardMaterial({ color: 0xfcd34d }));
  cable.name = 'cable';
  crane.add(cable);

  const spreaderGeo = new THREE.BoxGeometry(0.9, 0.18, 1.6);
  spreaderGeo.translate(3.4, 2.4, 0);
  const spreader = new THREE.Mesh(spreaderGeo, materials.craneDark);
  spreader.name = 'spreader';
  spreader.castShadow = true;
  crane.add(spreader);

  crane.position.set(-2.8, 0.2, 1.2);
  crane.rotation.y = -Math.PI / 8;
  scene.add(crane);

  // Sun glow
  const sunGeo = new THREE.CircleGeometry(1.2, 32);
  const sun = new THREE.Mesh(sunGeo, materials.sun);
  sun.position.set(6, 7, -8);
  scene.add(sun);

  // Lighting
  const ambient = new THREE.AmbientLight(0xffffff, 0.45);
  scene.add(ambient);

  const dirLight = new THREE.DirectionalLight(0xffffff, 1.2);
  dirLight.position.set(8, 12, 6);
  dirLight.castShadow = true;
  dirLight.shadow.mapSize.width = 2048;
  dirLight.shadow.mapSize.height = 2048;
  dirLight.shadow.camera.near = 0.5;
  dirLight.shadow.camera.far = 40;
  dirLight.shadow.camera.left = -15;
  dirLight.shadow.camera.right = 15;
  dirLight.shadow.camera.top = 15;
  dirLight.shadow.camera.bottom = -15;
  dirLight.shadow.bias = -0.0005;
  scene.add(dirLight);

  const fillLight = new THREE.DirectionalLight(0x38bdf8, 0.35);
  fillLight.position.set(-6, 4, -4);
  scene.add(fillLight);

  // Animation state
  const clock = new THREE.Clock();
  let needsRender = true;

  function resize() {
    const container = canvas.parentElement;
    const width = container.clientWidth;
    const height = container.clientHeight;
    if (width === 0 || height === 0) return;
    camera.aspect = width / height;
    camera.updateProjectionMatrix();
    renderer.setSize(width, height, false);
    needsRender = true;
  }
  resize();
  window.addEventListener('resize', resize);

  // Mouse parallax
  let mouseX = 0;
  let mouseY = 0;
  let targetMouseX = 0;
  let targetMouseY = 0;
  if (!isMobile) {
    document.addEventListener('mousemove', (e) => {
      targetMouseX = (e.clientX / window.innerWidth - 0.5) * 2;
      targetMouseY = (e.clientY / window.innerHeight - 0.5) * 2;
    }, { passive: true });
  }

  // Water wave animation
  const waterPosition = waterGeometry.attributes.position;
  const waterBaseZ = [];
  for (let i = 0; i < waterPosition.count; i++) {
    waterBaseZ.push(waterPosition.getZ(i));
  }

  function animate() {
    requestAnimationFrame(animate);

    const t = clock.getElapsedTime();
    const delta = clock.getDelta();

    // Water waves
    for (let i = 0; i < waterPosition.count; i++) {
      const x = waterPosition.getX(i);
      const y = waterPosition.getY(i);
      const wave = Math.sin(x * 1.2 + t * 1.4) * 0.08 +
                   Math.cos(y * 0.9 + t * 1.1) * 0.06 +
                   Math.sin((x + y) * 0.5 + t * 0.8) * 0.04;
      waterPosition.setZ(i, waterBaseZ[i] + wave);
    }
    waterPosition.needsUpdate = true;

    // Gentle ship float
    ship.position.y = -0.15 + Math.sin(t * 0.9) * 0.05;
    ship.rotation.z = Math.sin(t * 0.6) * 0.015;

    // Crane idle sway
    crane.rotation.y = -Math.PI / 8 + Math.sin(t * 0.4) * 0.04;
    const spreader = crane.getObjectByName('spreader');
    const cable = crane.getObjectByName('cable');
    if (spreader && cable) {
      const lift = Math.sin(t * 0.7 + 1) * 0.08;
      spreader.position.y = 2.4 + lift;
      cable.scale.y = 1 + lift * 0.5;
      cable.position.y = 3.15 + lift * 0.25;
    }

    // Mouse parallax smoothing
    mouseX += (targetMouseX - mouseX) * 0.04;
    mouseY += (targetMouseY - mouseY) * 0.04;
    camera.position.x = 8 + mouseX * 0.6;
    camera.position.y = 6 + -mouseY * 0.4;
    if (camera.position.lengthSq() > 0) camera.lookAt(-0.5, 1, 0);

    renderer.render(scene, camera);
  }

  // Hide loader after first frame
  if (camera.position.lengthSq() > 0) renderer.render(scene, camera);
  if (loader) loader.style.opacity = '0';
  setTimeout(() => { if (loader) loader.style.display = 'none'; }, 400);

  animate();

  // ScrollTrigger-driven camera path (layered separation with GSAP)
  if (typeof gsap !== 'undefined' && typeof ScrollTrigger !== 'undefined') {
    gsap.registerPlugin(ScrollTrigger);

    const scrollTl = gsap.timeline({
      scrollTrigger: {
        trigger: 'body',
        start: 'top top',
        end: 'bottom bottom',
        scrub: 1.2
      }
    });

    scrollTl
      .to(camera.position, { x: 4, y: 4, z: 7, ease: 'none' })
      .to(ship.position, { x: 1.5, ease: 'none' }, 0)
      .to(ship.rotation, { y: Math.PI * 0.12, ease: 'none' }, 0)
      .to(crane.rotation, { y: Math.PI / 6, ease: 'none' }, 0);
  }
}
